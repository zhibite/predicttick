# Live collector (set to 1 on the deployed server; keep 0 for local dev)
POLY_COLLECTOR=0

# SQLite database file written by the in-process collector
# POLY_DB_PATH=/home/ubuntu/polyklines/data/live/polyklines.sqlite

# Business database (accounts, billing, jobs, strategies)
# POLY_APP_DB_PATH=/home/ubuntu/polyklines/data/app/app.sqlite

# Auth / email
POLY_APP_URL=http://localhost:3000
POLY_REQUIRE_EMAIL_VERIFICATION=0
POLY_EMAIL_DEV_LOG=1
# Comma-separated emails that are promoted to admin on registration.
# Prefer `npm run create-admin` for production bootstrap.
POLY_ADMIN_EMAILS=

# Crypto payments (payments stay hidden until wallets are configured in
# /admin/settings/payments and this flag is set to 1)
POLY_PAYMENTS_ENABLED=0

# CSV export worker (set to 0 to disable background export processing)
POLY_EXPORT_WORKER=1
# POLY_EXPORT_DIR=/home/ubuntu/polyklines/data/exports

# Public API CORS (comma-separated origins, or * for all)
POLY_API_CORS_ORIGINS=*

# Backtest worker (set to 0 to disable background backtest processing)
POLY_BACKTEST_WORKER=1

# Run export/backtest workers inside Next for local dev only.
# Production runs them in the separate polyklines-jobs service.
POLY_INLINE_WORKERS=0

# Backup directory and retention
# POLY_BACKUP_DIR=/home/ubuntu/polyklines-backups
POLY_BACKUP_KEEP_APP=14
POLY_BACKUP_KEEP_MARKET=7

# Comma-separated assets to track
POLY_ASSETS=btc,eth,bnb,sol,doge,xrp,hype

# Sampling intervals (5m markets are always sampled per second)
POLY_15M_SAMPLE_SECONDS=5
POLY_1H_SAMPLE_SECONDS=10
POLY_4H_SAMPLE_SECONDS=30

# Delete samples older than this many days (hourly cleanup)
POLY_RETENTION_DAYS=180

# Manually curated trader leaderboard (Polymarket Data/Gamma APIs)
POLY_LEADERBOARD_SYNC=1
POLY_LEADERBOARD_SYNC_MINUTES=30
POLY_LEADERBOARD_MAX_POSITIONS=1000
POLY_LEADERBOARD_MAX_CLOSED=500
POLY_LEADERBOARD_MAX_TRADES=1000

# Admin-only paper trading engine (simulated fills, no real orders)
POLY_PAPER_ENGINE=1
POLY_PAPER_TICK_SECONDS=5
